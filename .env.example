# Copy this file to `.env` and fill in your Supabase project's values.
# Project settings -> API in the Supabase dashboard.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Razorpay key ID only - safe to embed client-side (used to open Checkout).
# The key SECRET must never go here; it's a Supabase Edge Function secret
# only - see scripts/MIGRATION_RAZORPAY.md.
RAZORPAY_KEY_ID=your-razorpay-key-id

# Google Cloud API key with the Geocoding API enabled and billing set up.
# Used client-side for reverse geocoding ("use my location" -> address), so
# it must be restricted in Google Cloud Console (Android app restriction:
# this app's package name + release keystore SHA-1) rather than kept
# secret - Google's Maps Platform keys are designed to be embedded in
# client apps and secured via these restrictions, not via a backend proxy.
GOOGLE_GEOCODING_API_KEY=your-google-geocoding-api-key

# The "Web application" OAuth client id from android/app/google-services.json
# (client_type: 3) - required by google_sign_in on Android as
# serverClientId, so Firebase can obtain a verifiable ID token. Not a
# secret - same reasoning as the geocoding key above.
GOOGLE_SIGN_IN_SERVER_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
