# Copy this file to `.env` and fill in your Supabase project's values.
# Project settings -> API in the Supabase dashboard.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Razorpay key ID only - safe to embed client-side (used to open Checkout).
# The key SECRET must never go here; it's a Supabase Edge Function secret
# only - see scripts/MIGRATION_RAZORPAY.md.
RAZORPAY_KEY_ID=your-razorpay-key-id
